{
    // VS Code offers to install these the first time you open this folder.
    // Say yes: without them there is no Python and no notebooks.
    "recommendations": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        // Finds the Python that `pixi install` put in .pixi, so that it shows
        // up in the kernel picker at all. It pulls in ms-python.vscode-python-envs
        // by itself, which is what reads the python-envs settings next door.
        "renan-r-santos.pixi-code",
        // Listed even though pixi-code already depends on it, so that a student
        // who has it disabled, or who installed the three by hand from the
        // Extensions panel, still ends up with a working set.
        "ms-python.vscode-python-envs"
    ]
}
