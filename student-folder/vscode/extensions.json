{
    // VS Code offers to install these the first time you open this folder.
    // Say yes: without them there is no Python and no notebooks.
    "recommendations": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        // The notes are written in Quarto's flavour of markdown. Without
        // this, a callout in a notebook's markdown cell arrives as raw
        // text with colons around it instead of a coloured box.
        "quarto.quarto",
        // Finds the Python that `pixi install` put in .pixi and selects it, so
        // that it is the kernel a notebook offers without anyone typing a path.
        // It also repairs an environment built by an older pixi: those are
        // missing a marker file, VS Code reads them as conda environments
        // instead, and every kernel start then waits 30 seconds for a command
        // that never returns.
        //
        // ms-python.vscode-python-envs is deliberately NOT recommended here.
        // It arrives anyway, inside ms-python.python's extension pack, but it
        // has no pixi support and takes environment handling away from the
        // extension that does. "python.useEnvironmentsExtension" next door
        // switches that off.
        "munch-group.im-pixi-vscode"
    ],

    // Deliberately not on this course. The assistant lives in the browser,
    // where you have to go to it on purpose and can see what you asked and
    // what it answered. An editor that quietly finishes your sentences is the
    // one thing that stops you learning to write them. chat.disableAIFeatures
    // next door switches off the ones VS Code now ships with.
    "unwantedRecommendations": [
        "github.copilot",
        "github.copilot-chat",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-containers",
        "eamodio.gitlens",
        "vscodevim.vim",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
    ]
}
